{
  "name": "flipro",
  "version": "0.1.0",
  "private": true,
  "description": "A transparent Flibusta OPDS proxy for ebook readers",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "node --test tests/*.test.ts",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "check": "pnpm run lint && pnpm run format && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@xmldom/xmldom": "^0.9.12",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
